---
/**
 * Datenschutzerklärung – rechtliche Pflichtseite.
 *
 * Der komplette Text kommt aus src/data/pages/datenschutz.json und ist im
 * CMS bearbeitbar. Adresse und E-Mail werden über {{platzhalter}} aus
 * site.json eingesetzt, damit sie nur an einer Stelle gepflegt werden.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { heading, rich, blocks, fill } from '../lib/text';
import site from '../data/site.json';
import page from '../data/pages/datenschutz.json';

const nav = [
  { href: '/', label: 'Übersicht' },
  { href: '/sandstube', label: 'SandStube' },
  { href: '/wichtelstuebchen', label: 'Wichtelstübchen' },
  { href: '/team', label: 'Team' },
];

const platzhalter = {
  inhaberin: site.inhaberin,
  strasse: site.kontakt.strasse,
  plz_ort: site.kontakt.plz_ort,
  email: site.kontakt.email,
};
---
<BaseLayout
  title={page.seo.titel}
  description={page.seo.beschreibung}
  theme="hub"
  nav={nav}
  activeNav="/"
  noindex
  brand={{ type: 'svg', svg: 'hub', href: '/', label: 'Maria Bretthauer', sub: 'Siegen · zwei Angebote' }}
>
  <section class="hero band--tight">
    <div class="wrap wrap--narrow center">
      <span class="kicker">{page.kicker}</span>
      <h1 set:html={heading(page.ueberschrift)} />
    </div>
  </section>

  <div class="edge" style="--from:var(--paper);--to:var(--paper-2)"></div>

  <section class="band band--white">
    <div class="wrap wrap--narrow legal">

      {page.warnung.anzeigen && (
        <div class="warn" set:html={rich(page.warnung.text)} />
      )}

      {page.abschnitte.map((abschnitt) => (
        <Fragment>
          <h2>{abschnitt.ueberschrift}</h2>
          <Fragment set:html={blocks(fill(abschnitt.text, platzhalter))} />
        </Fragment>
      ))}

    </div>
  </section>
</BaseLayout>
