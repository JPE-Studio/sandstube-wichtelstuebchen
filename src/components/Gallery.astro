---
/**
 * Bildergalerie als barrierefreier, Lighthouse-freundlicher Slider.
 *
 * - Bildanzahl ist beliebig (kommt aus dem CMS).
 * - Nur das erste Bild wird eager geladen, alle weiteren lazy.
 * - Feste 4:3-Seitenverhältnisse verhindern Layout-Verschiebungen (CLS).
 * - Tastaturbedienung (Pfeile, Home/Ende), Swipe auf Touch-Geräten,
 *   ARIA-Rollen und Live-Ansagen für Screenreader.
 */
interface Props {
  bilder: Array<{ bild: string; alt: string }>;
  label?: string;
}

const { bilder, label = 'Bildergalerie' } = Astro.props;
---

{bilder.length > 0 && (
  <div
    class="slider"
    data-slider
    data-reveal
    role="region"
    aria-roledescription="Karussell"
    aria-label={label}
  >
    <div class="slider__viewport">
      <div class="slider__track" data-slider-track>
        {bilder.map((eintrag, i) => (
          <figure
            class="slider__slide"
            role="group"
            aria-roledescription="Folie"
            aria-label={`${i + 1} von ${bilder.length}`}
            aria-hidden={i === 0 ? undefined : 'true'}
            data-slider-slide
          >
            <img
              src={eintrag.bild}
              alt={eintrag.alt}
              width="1200"
              height="900"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>

    {bilder.length > 1 && (
      <div class="slider__controls">
        <button type="button" class="slider__btn" data-slider-prev aria-label="Vorheriges Bild">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <div class="slider__dots" data-slider-dots aria-label="Bild auswählen">
          {bilder.map((_, i) => (
            <button
              type="button"
              class="slider__dot"
              data-slider-dot={i}
              aria-current={i === 0 ? 'true' : undefined}
              aria-label={`Bild ${i + 1} anzeigen`}
            />
          ))}
        </div>

        <button type="button" class="slider__btn" data-slider-next aria-label="Nächstes Bild">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    )}

    <p class="visually-hidden" data-slider-live aria-live="polite"></p>
  </div>
)}
