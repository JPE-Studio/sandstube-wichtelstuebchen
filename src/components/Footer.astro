---
/**
 * Footer – <footer class="site-foot">, identisch auf allen Seiten.
 * Ersetzt die 6-fach duplizierte Fußzeile aus den Original-HTML-Dateien.
 * Zieht alle Texte/Links aus src/data/ui.json, Adress-/Kontaktdaten
 * aus src/data/site.json – beides über Decap CMS pflegbar.
 */
import site from '../data/site.json';
import ui from '../data/ui.json';
import { rich, fill } from '../lib/text';
import { telefonVorhanden, telHref, waHref } from '../lib/kontakt';

interface Props {
  note?: string;
}
const { note } = Astro.props;
const footNote = note ?? site.wichtelstuebchen.anerkennung;

// Platzhalter für Footer-Texte ({{inhaberin}}, {{jahr}}, …)
const p = {
  inhaberin: site.inhaberin,
  strasse: site.kontakt.strasse,
  plz_ort: site.kontakt.plz_ort,
  email: site.kontakt.email,
  telefon: site.kontakt.telefon,
  telefon_href: telefonVorhanden ? telHref : 'tel:',
  whatsapp_url: telefonVorhanden ? waHref : '#',
  jahr: site.jahr,
  wichtelkompass_url: site.wichtelstuebchen.wichtelkompass_url,
};

const f = ui.footer;
---
<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-brandline">
          <img src={f.logo} alt={ui.ui_strings.footer_logo_alt || undefined} aria-hidden={!ui.ui_strings.footer_logo_alt} />
        </div>
        <p set:html={rich(fill(f.einleitung, p))} />
      </div>

      <div>
        <span class="foot-tag foot-tag--sand">{f.spalte_sandstube.tag}</span>
        <h4>{f.spalte_sandstube.titel}</h4>
        <div class="foot-links">
          {f.spalte_sandstube.links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </div>
      </div>

      <div>
        <span class="foot-tag foot-tag--wichtel">{f.spalte_wichtelstuebchen.tag}</span>
        <h4>{f.spalte_wichtelstuebchen.titel}</h4>
        <div class="foot-links">
          {f.spalte_wichtelstuebchen.links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </div>
      </div>

      <div>
        <h4>{f.spalte_kontakt.titel}</h4>
        <div class="foot-links">
          {f.spalte_kontakt.links.map((l) => {
            // {{platzhalter}} in Label & href einsetzen; externe Links öffnen im neuen Tab
            return (
              <a
                href={fill(l.href, p)}
                target={l.extern ? '_blank' : undefined}
                rel={l.extern ? 'noopener' : undefined}
              >{fill(l.label, p)}</a>
            );
          })}
        </div>
      </div>
    </div>

    <div class="foot-bottom">
      <span set:html={rich(fill(f.copyright, p))} />
      <span>{footNote}</span>
    </div>
  </div>
</footer>
